---
// Administrace přihlášek – přihlášení přes Supabase Auth, data chrání pravidla v databázi.
// Stránka se neindexuje a bez přihlášení nic nenačte.
import '../styles/global.css';
import { supabase } from '../data/supabase.js';
import { site } from '../data/content.js';

const home = import.meta.env.BASE_URL;
const statuses = [
  { value: 'nova', label: 'Nová', plural: 'Nové' },
  { value: 'zaplaceno', label: 'Zaplaceno', plural: 'Zaplaceno' },
  { value: 'zarazen', label: 'Zařazen/a', plural: 'Zařazení' },
  { value: 'odhlasen', label: 'Odhlášen/a', plural: 'Odhlášení' },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#000000" />
    <title>Administrace přihlášek | {site.name}</title>
    <link rel="icon" type="image/png" sizes="48x48" href={`${home}favicon-48.png`} />
  </head>
  <body>
    <div
      class="admin"
      data-admin
      data-url={supabase.url}
      data-key={supabase.publishableKey}
      data-table={supabase.table}
      data-statuses={JSON.stringify(statuses)}
    >
      <header class="bar">
        <a class="bar__brand" href={home}>Taneční Škola <span>Nový Jičín</span></a>
        <span class="bar__tag">Administrace</span>
        <div class="bar__user" data-user hidden>
          <span class="bar__email" data-user-email></span>
          <button class="btn btn--ghost btn--small" type="button" data-logout>Odhlásit se</button>
        </div>
      </header>

      <main class="main">
        <!-- Přihlášení -->
        <section class="login" data-view="login" hidden>
          <form class="login__card" data-login-form>
            <p class="tag">Přístup pro správce</p>
            <h1 class="login__title">Přihlášení</h1>
            <label class="field">
              <span>E-mail</span>
              <input type="email" name="email" autocomplete="username" required />
            </label>
            <label class="field">
              <span>Heslo</span>
              <input type="password" name="password" autocomplete="current-password" required />
            </label>
            <button class="btn" type="submit">Přihlásit se</button>
            <p class="login__error" role="alert" data-login-error></p>
          </form>
        </section>

        <!-- Načítání / chybějící oprávnění -->
        <section class="notice" data-view="notice" hidden>
          <p data-notice-text>Načítám…</p>
        </section>

        <!-- Přehled přihlášek -->
        <section class="app" data-view="app" hidden>
          <div class="app__head">
            <div>
              <p class="tag">Přihlášky do kurzu</p>
              <h1 class="app__title">Přehled přihlášek</h1>
            </div>
            <div class="app__actions">
              <button class="btn btn--ghost" type="button" data-refresh>Obnovit</button>
              <button class="btn" type="button" data-export>Export do Excelu</button>
            </div>
          </div>

          <!-- Souhrn – kliknutím se filtruje podle stavu -->
          <div class="stats" data-stats></div>

          <div class="toolbar">
            <label class="search">
              <span class="sr-only">Hledat</span>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
              <input type="search" placeholder="Hledat jméno, školu, e-mail, telefon…" data-search />
            </label>
            <select class="select" data-filter aria-label="Filtrovat podle stavu">
              <option value="">Všechny stavy</option>
              {statuses.map((s) => <option value={s.value}>{s.label}</option>)}
            </select>
          </div>

          <div class="list">
            <table class="table">
              <thead>
                <tr>
                  <th>Uchazeč</th>
                  <th>Narozen/a</th>
                  <th>Škola</th>
                  <th>Kontakt</th>
                  <th>Adresa</th>
                  <th>Poznámka</th>
                  <th>Stav</th>
                  <th>Interní poznámka</th>
                  <th><span class="sr-only">Akce</span></th>
                </tr>
              </thead>
              <tbody data-rows></tbody>
            </table>
            <p class="empty" data-empty hidden></p>
          </div>
        </section>
      </main>

      <p class="toast" role="status" aria-live="polite" data-toast></p>
    </div>

    <!-- is:global – řádky a souhrn vytváří skript, scoped styly by na ně nedosáhly -->
    <style is:global>
      /* Atribut hidden musí mít přednost před display z tříd */
      [hidden] {
        display: none !important;
      }

      .admin {
        --st-nova: var(--accent);
        --st-zaplaceno: var(--tone-2);
        --st-zarazen: #6fcf97;
        --st-odhlasen: #6e6e6e;
        min-height: 100vh;
      }

      /* ───── Horní lišta */
      .bar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 1rem;
        height: 64px;
        padding-inline: clamp(1rem, 3vw, 2.5rem);
        border-bottom: 1px solid var(--line);
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }

      .bar__brand {
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
      }

      .bar__brand span {
        color: var(--text-muted);
      }

      .bar__tag {
        padding: 0.3rem 0.65rem;
        border: 1px solid var(--line-strong);
        border-radius: 999px;
        color: var(--text-muted);
        font-size: 0.72rem;
      }

      .bar__user {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        margin-left: auto;
      }

      .bar__email {
        color: var(--text-subtle);
        font-size: 0.82rem;
      }

      .main {
        width: 100%;
        max-width: 1400px;
        margin-inline: auto;
        padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 3vw, 2.5rem) 4rem;
      }

      .tag {
        color: var(--text-subtle);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      /* ───── Tlačítka a pole */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0.55rem 1.1rem;
        border: 1px solid #fff;
        border-radius: 10px;
        background: #fff;
        color: #000;
        font-size: 0.875rem;
        font-weight: 500;
        white-space: nowrap;
        cursor: pointer;
        transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease);
      }

      .btn:hover {
        background: #e6e6e6;
      }

      .btn--ghost {
        border-color: var(--line-strong);
        background: transparent;
        color: var(--text);
      }

      .btn--ghost:hover {
        background: rgba(255, 255, 255, 0.06);
      }

      .btn--small {
        min-height: 34px;
        padding: 0.35rem 0.8rem;
        font-size: 0.8rem;
      }

      .btn:disabled {
        opacity: 0.6;
        cursor: progress;
      }

      .field {
        display: grid;
        gap: 0.4rem;
        font-size: 0.85rem;
        font-weight: 500;
      }

      .field input,
      .search input,
      .select,
      .table select,
      .table textarea {
        width: 100%;
        min-height: 44px;
        padding: 0.6rem 0.8rem;
        border: 1px solid var(--line-strong);
        border-radius: 10px;
        background: #0b0b0b;
        color: var(--text);
        font-size: 0.9rem;
        transition: border-color 0.2s var(--ease);
      }

      .field input:focus,
      .search input:focus,
      .select:focus,
      .table select:focus,
      .table textarea:focus {
        outline: none;
        border-color: var(--accent);
      }

      /* ───── Přihlášení */
      .login {
        display: grid;
        place-items: center;
        min-height: calc(100vh - 64px - 8rem);
      }

      .login__card {
        display: grid;
        gap: 1.1rem;
        width: min(100%, 400px);
        padding: clamp(1.5rem, 5vw, 2.25rem);
        border: 1px solid var(--line);
        background: var(--surface);
      }

      .login__title {
        margin-bottom: 0.25rem;
        font-size: 1.75rem;
        font-weight: 500;
        letter-spacing: -0.02em;
      }

      .login__error {
        color: #ff9a9a;
        font-size: 0.85rem;
      }

      .login__error:empty {
        display: none;
      }

      .notice {
        padding: 5rem 1rem;
        color: var(--text-muted);
        text-align: center;
      }

      /* ───── Přehled */
      .app__head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem 2rem;
        margin-bottom: 1.75rem;
      }

      .app__title {
        margin-top: 0.4rem;
        font-size: clamp(1.75rem, 3.5vw, 2.4rem);
        font-weight: 500;
        letter-spacing: -0.03em;
      }

      .app__actions {
        display: flex;
        gap: 0.6rem;
      }

      /* Souhrn podle stavů */
      .stats {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        margin-bottom: 1.5rem;
        border-top: 1px solid var(--line);
        border-left: 1px solid var(--line);
      }

      .stat {
        display: grid;
        gap: 0.35rem;
        padding: 1.1rem 1.2rem;
        border: 0;
        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        background: transparent;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition: background-color 0.2s var(--ease);
      }

      .stat:hover {
        background: rgba(255, 255, 255, 0.03);
      }

      .stat[aria-pressed='true'] {
        background: rgba(255, 255, 255, 0.06);
      }

      .stat__label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        font-size: 0.8rem;
      }

      .stat__value {
        font-size: 1.9rem;
        font-weight: 500;
        line-height: 1;
        letter-spacing: -0.03em;
      }

      .dot {
        flex: none;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--dot, var(--text-subtle));
      }

      .toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1rem;
      }

      .search {
        position: relative;
        flex: 1 1 320px;
      }

      .search svg {
        position: absolute;
        top: 50%;
        left: 0.8rem;
        color: var(--text-subtle);
        transform: translateY(-50%);
        pointer-events: none;
      }

      .search input {
        padding-left: 2.4rem;
      }

      .select {
        flex: 0 1 220px;
        width: auto;
      }

      /* ───── Tabulka (na mobilu karty) */
      .list {
        border: 1px solid var(--line);
      }

      .table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
      }

      .table th {
        padding: 0.8rem 0.9rem;
        border-bottom: 1px solid var(--line);
        background: #0b0b0b;
        color: var(--text-subtle);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 400;
        letter-spacing: 0.04em;
        text-align: left;
        text-transform: uppercase;
        white-space: nowrap;
      }

      .table td {
        padding: 0.9rem;
        border-top: 1px solid var(--line);
        vertical-align: top;
      }

      .table td.cell--person {
        min-width: 190px;
      }

      .table td:nth-child(2) {
        white-space: nowrap;
      }

      .table tbody tr:first-child td {
        border-top: 0;
      }

      .table tbody tr {
        transition: background-color 0.2s var(--ease);
      }

      .table tbody tr:hover {
        background: rgba(255, 255, 255, 0.02);
      }

      .person__name {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 0.95rem;
        font-weight: 500;
      }

      .muted {
        display: block;
        margin-top: 0.2rem;
        color: var(--text-subtle);
        font-size: 0.78rem;
      }

      .table a {
        text-decoration: none;
      }

      .table a:hover {
        color: var(--accent);
      }

      .note {
        max-width: 240px;
        color: var(--text-muted);
        white-space: pre-wrap;
      }

      .status {
        position: relative;
        min-width: 150px;
      }

      .status .dot {
        position: absolute;
        top: 50%;
        left: 0.8rem;
        transform: translateY(-50%);
        pointer-events: none;
      }

      .table .status select {
        padding-left: 1.85rem;
      }

      .table textarea {
        min-width: 200px;
        min-height: 44px;
        resize: vertical;
      }

      .row--odhlasen .person__name,
      .row--odhlasen td:not(:nth-child(7)):not(:nth-child(8)) {
        opacity: 0.55;
      }

      .delete {
        padding: 0.4rem 0;
        border: 0;
        background: none;
        color: #ff9a9a;
        font-size: 0.8rem;
        text-decoration: underline;
        text-underline-offset: 3px;
        cursor: pointer;
      }

      .empty {
        padding: 3rem 1rem;
        color: var(--text-muted);
        text-align: center;
      }

      .toast {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        left: auto;
        z-index: 20;
        max-width: calc(100% - 2rem);
        padding: 0.7rem 1rem;
        border: 1px solid var(--line-strong);
        border-radius: 10px;
        background: #111;
        font-size: 0.85rem;
        opacity: 0;
        transform: translateY(8px);
        transition:
          opacity 0.3s var(--ease),
          transform 0.3s var(--ease);
        pointer-events: none;
      }

      .toast.is-visible {
        opacity: 1;
        transform: none;
      }

      .toast.is-error {
        border-color: rgba(255, 122, 122, 0.5);
        color: #ffc2c2;
      }

      /* ───── Tablet: tabulka se posouvá do strany */
      @media (max-width: 1200px) and (min-width: 901px) {
        .list {
          overflow-x: auto;
        }

        .table {
          min-width: 1100px;
        }
      }

      /* ───── Mobil: každá přihláška jako karta */
      @media (max-width: 900px) {
        .bar__email {
          display: none;
        }

        .app__actions {
          width: 100%;
        }

        .app__actions .btn {
          flex: 1;
        }

        .stats {
          grid-template-columns: repeat(2, 1fr);
        }

        .stat:first-child {
          grid-column: 1 / -1;
        }

        .select {
          flex: 1 1 100%;
        }

        .list {
          border: 0;
        }

        .table thead {
          display: none;
        }

        .table,
        .table tbody,
        .table tr,
        .table td {
          display: block;
          width: 100%;
        }

        .table tbody {
          display: grid;
          gap: 0.75rem;
        }

        .table tbody tr {
          display: grid;
          grid-template-columns: 1fr 1fr;
          border: 1px solid var(--line);
          background: var(--surface);
        }

        .table td {
          padding: 0.75rem 1rem;
          border-top: 1px solid var(--line);
        }

        .table td[data-label]::before {
          content: attr(data-label);
          display: block;
          margin-bottom: 0.3rem;
          color: var(--text-subtle);
          font-family: var(--font-mono);
          font-size: 0.66rem;
          letter-spacing: 0.04em;
          text-transform: uppercase;
        }

        /* Jméno přes celou šířku nahoře, ostatní v mřížce */
        .table td.cell--person,
        .table td.cell--wide {
          grid-column: 1 / -1;
        }

        .table td.cell--person {
          border-top: 0;
          padding-top: 1rem;
        }

        .table td.cell--person::before {
          display: none;
        }

        .table td.cell--narrow:nth-of-type(odd) {
          border-left: 1px solid var(--line);
        }

        .note {
          max-width: none;
        }

        .table textarea,
        .status {
          min-width: 0;
        }

        .table td.cell--actions {
          padding-block: 0.6rem 0.9rem;
        }
      }

      @media (max-width: 420px) {
        .bar__tag {
          display: none;
        }
      }
    </style>

    <script>
      import { createClient, type Session } from '@supabase/supabase-js';

      type Row = {
        id: string;
        created_at: string;
        jmeno: string;
        prijmeni: string;
        datum_narozeni: string;
        skola: string;
        adresa: string;
        email: string;
        telefon: string;
        poznamka: string | null;
        stav: string;
        interni_poznamka: string | null;
      };
      type Status = { value: string; label: string; plural: string };

      const root = document.querySelector<HTMLElement>('[data-admin]')!;
      const { url, key, table } = root.dataset as { url: string; key: string; table: string };
      const statuses: Status[] = JSON.parse(root.dataset.statuses!);
      const db = createClient(url, key, { auth: { persistSession: true } });

      const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
      const show = (name: 'login' | 'notice' | 'app') =>
        ['login', 'notice', 'app'].forEach((v) => ($(`[data-view="${v}"]`).hidden = v !== name));

      // Krátké oznámení vpravo dole
      let toastTimer = 0;
      const toast = (text: string, error = false) => {
        const node = $('[data-toast]');
        node.textContent = text;
        node.classList.toggle('is-error', error);
        node.classList.add('is-visible');
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => node.classList.remove('is-visible'), 2600);
      };

      const dateTime = (iso: string) =>
        new Date(iso).toLocaleString('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
      const date = (iso: string) => new Date(`${iso}T00:00:00`).toLocaleDateString('cs-CZ');
      const statusLabel = (value: string) => statuses.find((s) => s.value === value)?.label ?? value;
      const dotColor = (value: string) => `var(--st-${value})`;

      let rows: Row[] = [];

      // Prvky se vytváří přes textContent – data se nikdy nevkládají jako HTML
      const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text?: string | null, className?: string) => {
        const node = document.createElement(tag);
        if (text != null) node.textContent = text;
        if (className) node.className = className;
        return node;
      };
      const dot = (value: string) => {
        const d = el('span', null, 'dot');
        d.style.setProperty('--dot', dotColor(value));
        return d;
      };

      const filterSelect = () => $<HTMLSelectElement>('[data-filter]');

      const filtered = () => {
        const q = $<HTMLInputElement>('[data-search]').value.trim().toLowerCase();
        const stav = filterSelect().value;
        return rows.filter((r) => {
          if (stav && r.stav !== stav) return false;
          if (!q) return true;
          return [r.jmeno, r.prijmeni, r.skola, r.email, r.telefon, r.adresa, r.poznamka, r.interni_poznamka]
            .join(' ')
            .toLowerCase()
            .includes(q);
        });
      };

      // ───── Souhrn (tlačítka filtrují podle stavu)
      const renderStats = () => {
        const box = $('[data-stats]');
        box.replaceChildren();
        const current = filterSelect().value;
        const items = [{ value: '', plural: 'Celkem' }, ...statuses];
        items.forEach((s) => {
          const btn = el('button', null, 'stat');
          btn.type = 'button';
          btn.setAttribute('aria-pressed', String(current === s.value));
          const label = el('span', null, 'stat__label');
          if (s.value) label.append(dot(s.value));
          label.append(s.plural);
          const count = s.value ? rows.filter((r) => r.stav === s.value).length : rows.length;
          btn.append(label, el('span', String(count), 'stat__value'));
          btn.addEventListener('click', () => {
            filterSelect().value = current === s.value ? '' : s.value;
            renderStats();
            render();
          });
          box.append(btn);
        });
      };

      // ───── Seznam
      const cell = (label: string | null, className = 'cell--narrow') => {
        const td = el('td', null, className);
        if (label) td.dataset.label = label;
        return td;
      };

      const render = () => {
        const tbody = $('[data-rows]');
        tbody.replaceChildren();
        const list = filtered();
        const empty = $('[data-empty]');
        empty.hidden = list.length > 0;
        empty.textContent = rows.length
          ? 'Žádné přihlášky neodpovídají hledání nebo filtru.'
          : 'Zatím tu nejsou žádné přihlášky. Jakmile někdo odešle formulář na webu, objeví se zde.';

        list.forEach((r) => {
          const tr = el('tr', null, `row--${r.stav}`);

          const person = cell(null, 'cell--person');
          const name = el('span', null, 'person__name');
          const nameDot = dot(r.stav);
          name.append(nameDot, `${r.jmeno} ${r.prijmeni}`);
          person.append(name, el('span', `Přijato ${dateTime(r.created_at)}`, 'muted'));

          const born = cell('Narozen/a');
          born.textContent = date(r.datum_narozeni);

          const school = cell('Škola');
          school.textContent = r.skola;

          const contactCell = cell('Kontakt', 'cell--wide');
          const mail = el('a', r.email);
          mail.href = `mailto:${r.email}`;
          const phone = el('a', r.telefon, 'muted');
          phone.href = `tel:${r.telefon.replace(/\s/g, '')}`;
          contactCell.append(mail, phone);

          const address = cell('Adresa', 'cell--wide');
          address.textContent = r.adresa;

          const noteFromForm = cell('Poznámka', 'cell--wide');
          noteFromForm.append(el('span', r.poznamka || '—', 'note'));

          // Stav – uloží se hned po změně
          const stavCell = cell('Stav', 'cell--wide');
          const wrap = el('div', null, 'status');
          const stDot = dot(r.stav);
          const select = el('select');
          select.setAttribute('aria-label', `Stav přihlášky ${r.jmeno} ${r.prijmeni}`);
          statuses.forEach((s) => {
            const opt = el('option', s.label);
            opt.value = s.value;
            opt.selected = s.value === r.stav;
            select.append(opt);
          });
          select.addEventListener('change', async () => {
            const { error } = await db.from(table).update({ stav: select.value }).eq('id', r.id);
            if (error) {
              select.value = r.stav;
              return toast('Stav se nepodařilo uložit.', true);
            }
            r.stav = select.value;
            tr.className = `row--${r.stav}`;
            [stDot, nameDot].forEach((d) => d.style.setProperty('--dot', dotColor(r.stav)));
            renderStats();
            toast(`Stav změněn na „${statusLabel(r.stav)}“.`);
          });
          wrap.append(stDot, select);
          stavCell.append(wrap);

          // Interní poznámka – uloží se po opuštění pole
          const noteCell = cell('Interní poznámka', 'cell--wide');
          const note = el('textarea');
          note.rows = 2;
          note.placeholder = 'Jen pro vás…';
          note.value = r.interni_poznamka ?? '';
          note.setAttribute('aria-label', `Interní poznámka k přihlášce ${r.jmeno} ${r.prijmeni}`);
          note.addEventListener('change', async () => {
            const value = note.value.trim() || null;
            const { error } = await db.from(table).update({ interni_poznamka: value }).eq('id', r.id);
            if (error) return toast('Poznámku se nepodařilo uložit.', true);
            r.interni_poznamka = value;
            toast('Poznámka uložena.');
          });
          noteCell.append(note);

          // Smazání (GDPR – na vyžádání nebo po kurzu)
          const actions = cell(null, 'cell--wide cell--actions');
          const del = el('button', 'Smazat', 'delete');
          del.type = 'button';
          del.addEventListener('click', async () => {
            if (!confirm(`Opravdu trvale smazat přihlášku ${r.jmeno} ${r.prijmeni}? Tuto akci nelze vrátit.`)) return;
            const { error } = await db.from(table).delete().eq('id', r.id);
            if (error) return toast('Přihlášku se nepodařilo smazat.', true);
            rows = rows.filter((x) => x.id !== r.id);
            renderStats();
            render();
            toast('Přihláška smazána.');
          });
          actions.append(del);

          tr.append(person, born, school, contactCell, address, noteFromForm, stavCell, noteCell, actions);
          tbody.append(tr);
        });
      };

      // ───── Načtení dat
      const load = async () => {
        const btn = $<HTMLButtonElement>('[data-refresh]');
        btn.disabled = true;
        const { data, error } = await db.from(table).select('*').order('created_at', { ascending: false });
        btn.disabled = false;
        if (error) return toast('Přihlášky se nepodařilo načíst.', true);
        rows = data as Row[];
        renderStats();
        render();
      };

      const enter = async (session: Session | null) => {
        $('[data-user]').hidden = !session;
        $('[data-user-email]').textContent = session?.user.email ?? '';
        if (!session) return show('login');

        show('notice');
        $('[data-notice-text]').textContent = 'Načítám přihlášky…';
        const { data: isAdmin, error } = await db.rpc('is_admin');
        if (error || !isAdmin) {
          $('[data-notice-text]').textContent =
            'Tento účet nemá oprávnění k přihláškám. Přidejte ho do tabulky administrátorů (viz supabase/schema.sql).';
          return;
        }
        show('app');
        await load();
      };

      // ───── Export do Excelu (CSV se středníkem a BOM – Excel ho otevře se správnou diakritikou)
      const exportCsv = () => {
        const head = ['Přijato', 'Jméno', 'Příjmení', 'Datum narození', 'Škola', 'Adresa', 'E-mail', 'Telefon', 'Poznámka', 'Stav', 'Interní poznámka'];
        const q = (v: string | null) => `"${String(v ?? '').replace(/"/g, '""')}"`;
        const lines = filtered().map((r) =>
          [dateTime(r.created_at), r.jmeno, r.prijmeni, date(r.datum_narozeni), r.skola, r.adresa, r.email, r.telefon, r.poznamka, statusLabel(r.stav), r.interni_poznamka]
            .map(q)
            .join(';'),
        );
        const csv = '﻿' + [head.map(q).join(';'), ...lines].join('\r\n');
        const link = document.createElement('a');
        link.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
        link.download = `prihlasky-${new Date().toISOString().slice(0, 10)}.csv`;
        link.click();
        URL.revokeObjectURL(link.href);
      };

      // ───── Události
      $('[data-login-form]').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.currentTarget as HTMLFormElement;
        const button = form.querySelector('button')!;
        const errorEl = $('[data-login-error]');
        errorEl.textContent = '';
        button.disabled = true;
        const fd = new FormData(form);
        const { error } = await db.auth.signInWithPassword({
          email: String(fd.get('email')),
          password: String(fd.get('password')),
        });
        button.disabled = false;
        if (error) errorEl.textContent = 'Nesprávný e-mail nebo heslo.';
        else form.reset();
      });

      $('[data-logout]').addEventListener('click', () => db.auth.signOut());
      $('[data-refresh]').addEventListener('click', load);
      $('[data-export]').addEventListener('click', exportCsv);
      $('[data-search]').addEventListener('input', render);
      filterSelect().addEventListener('change', () => {
        renderStats();
        render();
      });

      // Volání databáze se odkládá mimo callback (doporučení supabase-js – jinak hrozí zablokování)
      db.auth.onAuthStateChange((event, session) => {
        if (event === 'INITIAL_SESSION' || event === 'SIGNED_IN' || event === 'SIGNED_OUT') {
          setTimeout(() => enter(session), 0);
        }
      });
    </script>
  </body>
</html>
