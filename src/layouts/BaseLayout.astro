---
import '../styles/global.css';
import { site, course, venue, contact, lecturers, faq } from '../data/content.js';
// Fonty pro nadpis v úvodu (latinka + česká diakritika) se načítají přednostně
import fontLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import fontLatinExt from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-ext-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;
// Soubory z public/ s ohledem na případný podadresář (např. GitHub Pages)
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path}`;
const ogImage = new URL(asset('og-image.jpg'), Astro.site).href;

// Strukturovaná data pro vyhledávače (sestavená z content.js)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#web`,
      url: site.url,
      name: site.name,
      inLanguage: 'cs',
      publisher: { '@id': `${site.url}/#skola` },
    },
    {
      '@type': 'DanceSchool',
      '@id': `${site.url}/#skola`,
      name: site.name,
      url: site.url,
      image: ogImage,
      foundingDate: String(site.since),
      telephone: `+420 ${contact.phone}`,
      email: contact.email,
      areaServed: [venue.city, 'Kopřivnice', 'Příbor', 'Frenštát pod Radhoštěm'],
      taxID: contact.ico,
      address: { '@type': 'PostalAddress', addressLocality: venue.city, addressCountry: 'CZ' },
    },
    {
      '@type': 'Course',
      name: site.courseName,
      description: site.description,
      inLanguage: 'cs',
      provider: { '@id': `${site.url}/#skola` },
      hasCourseInstance: {
        '@type': 'CourseInstance',
        courseMode: 'onsite',
        startDate: course.startDate,
        courseSchedule: {
          '@type': 'Schedule',
          repeatFrequency: 'P1W',
          byDay: 'https://schema.org/Monday',
          startTime: '18:00',
          endTime: '20:00',
          repeatCount: course.lessons,
        },
        location: { '@type': 'Place', name: venue.name, address: venue.city },
        instructor: lecturers.people.map((p) => ({ '@type': 'Person', name: p.name })),
      },
      offers: {
        '@type': 'Offer',
        price: course.priceValue,
        priceCurrency: 'CZK',
        category: 'Paid',
        url: `${site.url}/#prihlaska`,
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.items.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#020202" />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontLatinExt} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/png" sizes="48x48" href={asset('favicon-48.png')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Účastníci tanečního kurzu v Novém Jičíně ve společenském oblečení" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přeskočit na obsah</a>
    <slot />
  </body>
</html>
