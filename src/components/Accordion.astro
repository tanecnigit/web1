---
import Icon from './Icon.astro';

interface Props {
  title: string;
  /** Položky se stejnou skupinou se otevírají výlučně (otevřením jedné se ostatní zavřou) */
  group?: string;
  open?: boolean;
}

const { title, group, open = false } = Astro.props;
---

<details class="accordion" data-accordion data-group={group} open={open}>
  <summary class="accordion__summary">
    <h3 class="accordion__title">{title}</h3>
    <span class="accordion__icon" aria-hidden="true">
      <Icon name="chevronDown" size={18} class="accordion__icon-closed" />
      <Icon name="arrowUp" size={18} class="accordion__icon-open" />
    </span>
  </summary>
  <div class="accordion__body" data-accordion-body>
    <div class="accordion__inner"><slot /></div>
  </div>
</details>

<style>
  /* Otázky jako řádky oddělené linkami – podle předlohy */
  .accordion {
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.015);
    transition: background-color 0.3s var(--ease);
  }

  .accordion:hover,
  .accordion.is-open {
    background: rgba(255, 255, 255, 0.03);
  }

  .accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.6rem, 3vw, 2.4rem) clamp(1.25rem, 3vw, 2.4rem);
    cursor: pointer;
    list-style: none;
  }

  .accordion.is-open .accordion__summary {
    padding-bottom: 1rem;
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__title {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .accordion__icon {
    position: relative;
    flex: none;
    display: grid;
    width: 20px;
    height: 20px;
    color: var(--text-muted);
    transition: color 0.3s var(--ease);
  }

  .accordion__icon :global(.icon) {
    grid-area: 1 / 1;
    transition:
      opacity 0.3s var(--ease),
      transform 0.4s var(--ease);
  }

  .accordion__icon :global(.accordion__icon-open) {
    opacity: 0;
    transform: translateY(4px);
  }

  .accordion__summary:hover .accordion__icon,
  .accordion.is-open .accordion__icon {
    color: var(--text);
  }

  .accordion.is-open .accordion__icon :global(.accordion__icon-closed),
  :global(html:not(.js)) .accordion[open] .accordion__icon :global(.accordion__icon-closed) {
    opacity: 0;
    transform: translateY(-4px);
  }

  .accordion.is-open .accordion__icon :global(.accordion__icon-open),
  :global(html:not(.js)) .accordion[open] .accordion__icon :global(.accordion__icon-open) {
    opacity: 1;
    transform: none;
  }

  .accordion__body {
    overflow: hidden;
  }

  .accordion__inner {
    max-width: 62ch;
    padding: 0 clamp(1.25rem, 3vw, 2.4rem) clamp(1.6rem, 3vw, 2.4rem);
    color: var(--text-muted);
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    line-height: 1.65;
    transition:
      opacity 0.45s var(--ease),
      transform 0.45s var(--ease);
  }

  :global(.js) .accordion:not(.is-open) .accordion__inner {
    opacity: 0;
    transform: translateY(-8px);
  }
</style>

<script>
  // Plynulé otevírání a zavírání – animuje se výška obsahu
  const DURATION = 450;
  const EASING = 'cubic-bezier(0.22, 1, 0.36, 1)';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-accordion]')];

  items.forEach((item) => item.classList.toggle('is-open', item.open));

  const animate = (item: HTMLDetailsElement, open: boolean) => {
    const body = item.querySelector<HTMLElement>('[data-accordion-body]')!;
    item.getAnimations({ subtree: true }).forEach((a) => a.cancel());

    if (open) {
      item.open = true;
      item.classList.add('is-open');
      if (reduced) return;
      body.animate([{ height: '0px' }, { height: `${body.scrollHeight}px` }], { duration: DURATION, easing: EASING });
    } else {
      item.classList.remove('is-open');
      if (reduced) {
        item.open = false;
        return;
      }
      const anim = body.animate([{ height: `${body.offsetHeight}px` }, { height: '0px' }], {
        duration: DURATION,
        easing: EASING,
      });
      anim.onfinish = () => {
        if (!item.classList.contains('is-open')) item.open = false;
      };
    }
  };

  items.forEach((item) => {
    item.querySelector('summary')?.addEventListener('click', (e) => {
      e.preventDefault();
      const opening = !item.classList.contains('is-open');
      if (opening && item.dataset.group) {
        items
          .filter((other) => other !== item && other.dataset.group === item.dataset.group && other.classList.contains('is-open'))
          .forEach((other) => animate(other, false));
      }
      animate(item, opening);
    });
  });
</script>
