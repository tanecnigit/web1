---
import { Picture } from 'astro:assets';
import Button from '../Button.astro';
import Corners from '../Corners.astro';
import { intro, facts, course, cta } from '../../data/content.js';
---

<section class="section intro" id="kurz" aria-labelledby="kurz-title">
  <div class="container">
    <div class="intro__grid">
      <div class="intro__text" data-reveal>
        <p class="badge">Taneční kurz 2026</p>
        <h2 class="section-title" id="kurz-title">{intro.title}</h2>
        {intro.paragraphs.map((p) => <p class="intro__p">{p}</p>)}
        <dl class="intro__meta">
          <div>
            <dt>Datum zahájení kurzu:</dt>
            <dd>{course.startShort}</dd>
          </div>
          <div>
            <dt>Cena kurzu:</dt>
            <dd>{course.price}/osobu</dd>
          </div>
        </dl>
        <Button href={cta.href} variant="waves">{cta.label}</Button>
      </div>

      <figure class="intro__media" data-reveal style="--reveal-delay: 0.1s">
        <Corners />
        <Picture
          src={intro.image.src}
          alt={intro.image.alt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[400, 600, 700, 800, 1000, 1300]}
          sizes="(max-width: 900px) calc(100vw - 3.5rem), 560px"
          class="intro__img"
        />
      </figure>
    </div>

    <div class="facts-wrap" data-reveal>
      <Corners only={['tr', 'bl']} />
      <ul class="facts cells" aria-label="Kurz v číslech">
        {
          facts.map((fact) => (
            <li class="facts__item cell">
              <Corners only={['tl', 'br']} />
              <span class="facts__value">{fact.value}</span>
              <span class="facts__label">{fact.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .intro__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .intro__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .intro__p {
    color: var(--text-muted);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
  }

  .intro__meta {
    display: grid;
    gap: 0.4rem;
    width: 100%;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .intro__meta div {
    display: flex;
    gap: 0.5rem;
  }

  .intro__meta dt {
    color: var(--text-subtle);
  }

  .intro__meta dd {
    margin: 0;
    font-weight: 500;
  }

  /* Fotka v rámečku z konstrukčních linek se čtverečky v rozích, dole se ztrácí do tmy */
  .intro__media {
    position: relative;
    margin: 0;
    border: 1px solid var(--line);
  }

  .intro__media :global(.intro__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 40%;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 45%, rgba(0, 0, 0, 0.85) 58%, rgba(0, 0, 0, 0.55) 72%, rgba(0, 0, 0, 0.22) 86%, rgba(0, 0, 0, 0.06) 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 45%, rgba(0, 0, 0, 0.85) 58%, rgba(0, 0, 0, 0.55) 72%, rgba(0, 0, 0, 0.22) 86%, rgba(0, 0, 0, 0.06) 100%);
  }


  .facts-wrap {
    position: relative;
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .facts {
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
  }

  .facts__item {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .facts__value {
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .facts__label {
    color: var(--text-subtle);
    font-size: 0.8rem;
    max-width: 22ch;
  }

  @media (max-width: 900px) {
    .intro__grid {
      grid-template-columns: 1fr;
    }

    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
