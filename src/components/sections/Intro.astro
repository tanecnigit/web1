---
import { Picture } from 'astro:assets';
import Button from '../Button.astro';
import { intro, facts, course, cta } from '../../data/content.js';
---

<section class="section intro" id="kurz" aria-labelledby="kurz-title">
  <div class="container">
    <div class="intro__grid">
      <div class="intro__text" data-reveal>
        <p class="badge">Taneční kurz 2026</p>
        <h2 class="section-title" id="kurz-title">{intro.title}</h2>
        {intro.paragraphs.map((p) => <p class="intro__p">{p}</p>)}
        <dl class="intro__meta">
          <div>
            <dt>Datum zahájení kurzu:</dt>
            <dd>{course.startShort}</dd>
          </div>
          <div>
            <dt>Cena kurzu:</dt>
            <dd>{course.price}/osobu</dd>
          </div>
        </dl>
        <Button href={cta.href} variant="waves">{cta.label}</Button>
      </div>

      <figure class="intro__media" data-reveal style="--reveal-delay: 0.1s">
        <span class="intro__node intro__node--tl" aria-hidden="true"></span>
        <span class="intro__node intro__node--tr" aria-hidden="true"></span>
        <span class="intro__node intro__node--bl" aria-hidden="true"></span>
        <span class="intro__node intro__node--br" aria-hidden="true"></span>
        <Picture
          src={intro.image.src}
          alt={intro.image.alt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[400, 600, 700, 800, 1000, 1300]}
          sizes="(max-width: 900px) calc(100vw - 3.5rem), 560px"
          class="intro__img"
        />
      </figure>
    </div>

    <ul class="facts" aria-label="Kurz v číslech">
      {
        facts.map((fact, i) => (
          <li class="facts__item" data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
            <span class="facts__value">{fact.value}</span>
            <span class="facts__label">{fact.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .intro__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .intro__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .intro__p {
    color: var(--text-muted);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
  }

  .intro__meta {
    display: grid;
    gap: 0.4rem;
    width: 100%;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .intro__meta div {
    display: flex;
    gap: 0.5rem;
  }

  .intro__meta dt {
    color: var(--text-subtle);
  }

  .intro__meta dd {
    margin: 0;
    font-weight: 500;
  }

  /* Fotka v rámečku z konstrukčních linek se čtverečky v rozích, dole se ztrácí do tmy */
  .intro__media {
    position: relative;
    margin: 0;
    border: 1px solid var(--line);
  }

  .intro__media :global(.intro__img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 40%;
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, rgba(0, 0, 0, 0.45) 68%, rgba(0, 0, 0, 0) 97%);
    mask-image: linear-gradient(to bottom, #000 35%, rgba(0, 0, 0, 0.45) 68%, rgba(0, 0, 0, 0) 97%);
  }

  .intro__node {
    position: absolute;
    z-index: 1;
    width: 9px;
    height: 9px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
  }

  .intro__node--tl {
    top: -5px;
    left: -5px;
  }

  .intro__node--tr {
    top: -5px;
    right: -5px;
  }

  .intro__node--bl {
    bottom: -5px;
    left: -5px;
  }

  .intro__node--br {
    bottom: -5px;
    right: -5px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .facts__item {
    display: grid;
    gap: 0.35rem;
  }

  .facts__value {
    font-size: clamp(2.25rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .facts__label {
    color: var(--text-subtle);
    font-size: 0.8rem;
    max-width: 22ch;
  }

  @media (max-width: 900px) {
    .intro__grid {
      grid-template-columns: 1fr;
    }

    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1rem;
    }
  }
</style>
