---
import { venue, contact, course } from '../../data/content.js';
---

<section class="section" id="kontakt" aria-labelledby="kontakt-title">
  <div class="container">
    <div class="contact__heading" data-reveal>
      <p class="badge">Kontakt</p>
      <h2 class="section-title" id="kontakt-title">Místo konání a kontakt</h2>
    </div>

    <div class="contact">
      <div class="contact__col" data-reveal>
        <p class="label">Kde</p>
        <p class="contact__main">{venue.name}</p>
        <p class="contact__sub">
          {venue.address ?? <span class="placeholder">{venue.addressPlaceholder}</span>}
          <br />{venue.city} · {venue.formerly}
        </p>
        <a class="contact__link" href={venue.mapUrl} target="_blank" rel="noopener">Zobrazit na mapě ↗</a>
      </div>

      <div class="contact__col" data-reveal style="--reveal-delay: 0.08s">
        <p class="label">Kdy</p>
        <p class="contact__main">Každé pondělí</p>
        <p class="contact__sub">{course.time}<br />od {course.startLabel}</p>
      </div>

      <div class="contact__col" data-reveal style="--reveal-delay: 0.16s">
        <p class="label">Kontakt · {contact.role.toLowerCase()}</p>
        <p class="contact__main">{contact.person}</p>
        <p class="contact__sub">
          <a href={contact.phoneHref}>{contact.phone}</a>
          <br /><a href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__heading {
    display: grid;
    gap: 1.1rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .contact {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }

  .contact__col {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.75rem 2rem 0 0;
  }

  .contact__col + .contact__col {
    padding-left: 2rem;
    border-left: 1px solid var(--line);
  }

  .contact__main {
    margin-top: 0.4rem;
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .contact__sub {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .contact__sub a,
  .contact__link {
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .contact__link {
    margin-top: 0.4rem;
    font-size: 0.9rem;
  }

  .contact__sub a:hover,
  .contact__link:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }

    .contact__col,
    .contact__col + .contact__col {
      padding: 1.5rem 0;
      border-left: 0;
    }

    .contact__col + .contact__col {
      border-top: 1px solid var(--line);
    }
  }
</style>
