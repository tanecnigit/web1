---
import { Image } from 'astro:assets';
import silhouette from '../../assets/brand/logo-silhouette.png';
import GradientBackground from '../GradientBackground.astro';
import { hero, course } from '../../data/content.js';
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <GradientBackground />
  <span class="frame-lines hero__lines" aria-hidden="true"></span>

  <div class="container hero__inner" data-hero-inner>
    <div class="hero__content">
      <Image
        src={silhouette}
        alt=""
        width={120}
        height={133}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="hero__mark"
      />
      <h1 class="hero__title display" id="hero-title">
        <span>{hero.titleLines[0]}</span>
        <span>{hero.titleLines[1]}</span>
      </h1>
      <p class="sr-only">{hero.lead}</p>
    </div>

    <div class="hero__bar">
      <div class="hero__meta">
        <span class="hero__label">Datum zahájení</span>
        <time class="hero__value" datetime={course.startDate}>{course.startShort}</time>
        <span class="hero__sub">každé pondělí {course.time}</span>
      </div>
      <div class="hero__meta hero__meta--end">
        <span class="hero__label">Cena kurzu</span>
        <span class="hero__value">{course.price}</span>
        <span class="hero__sub">{course.priceNote} · {course.lessons} lekcí</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero zůstává přišpendlený a další obsah přes něj vyjíždí zespodu */
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    isolation: isolate;
    background: var(--bg);
  }

  /* Ztmavení u spodní lišty kvůli čitelnosti */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 38%;
    background: linear-gradient(to top, rgba(2, 2, 2, 0.7), rgba(2, 2, 2, 0.3) 55%, transparent);
    pointer-events: none;
  }

  /* Konstrukční linky přes gradient – navazují na zbytek webu */
  .hero__lines {
    z-index: 1;
    border-color: rgba(255, 255, 255, 0.14);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding-top: var(--header-h);
    transform-origin: 50% 40%;
    will-change: transform, opacity;
  }

  .hero__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .hero__mark {
    width: clamp(72px, 8vw, 116px);
    height: auto;
    margin-bottom: clamp(1.25rem, 3vh, 2rem);
    animation: rise 1.2s var(--ease) both;
  }

  .hero__title {
    display: grid;
    font-size: clamp(3rem, 9.5vw, 6.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.35);
    animation: rise 1.2s 0.12s var(--ease) both;
  }

  /* Odsazené řádky jako na předloze */
  .hero__title span:first-child {
    transform: translateX(-0.9em);
  }

  .hero__title span:last-child {
    transform: translateX(0.9em);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  .hero__bar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 3vh, 2.25rem) clamp(1.75rem, 4vh, 2.75rem);
    border-top: 1px solid rgba(255, 255, 255, 0.28);
    animation: rise 1.2s 0.3s var(--ease) both;
  }

  .hero__meta {
    display: grid;
    gap: 0.3rem;
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
  }

  .hero__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  .hero__value {
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero__sub {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .hero__meta--end {
    text-align: right;
  }

  @media (max-width: 640px) {
    .hero__title span:first-child,
    .hero__title span:last-child {
      transform: none;
    }

    .hero__title {
      justify-items: center;
      text-align: center;
    }

    .hero__bar {
      gap: 1rem;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const inner = document.querySelector<HTMLElement>('[data-hero-inner]');

  if (hero && inner && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let covered = false;
    let ticking = false;
    // Výška hero se čte jen při změně velikosti, ne při každém posunu (žádný vynucený přepočet rozvržení)
    let heroHeight = window.innerHeight;
    new ResizeObserver(([entry]) => {
      heroHeight = entry.contentRect.height || window.innerHeight;
    }).observe(hero);

    const update = () => {
      ticking = false;
      const p = Math.min(Math.max(window.scrollY / heroHeight, 0), 1);
      inner.style.transform = `translateY(${p * -6}vh) scale(${1 - p * 0.08})`;
      inner.style.opacity = String(1 - p * 0.85);
      const isCovered = p >= 1;
      if (isCovered !== covered) {
        covered = isCovered;
        hero.style.visibility = covered ? 'hidden' : '';
        window.dispatchEvent(new CustomEvent('hero:covered', { detail: covered }));
      }
    };

    requestAnimationFrame(update);
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>
