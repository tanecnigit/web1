---
import SectionHeader from '../SectionHeader.astro';
import { terms } from '../../data/content.js';

// Každý blok má vlastní odstín z gradientu v úvodu
const blocks = [
  { ...terms.storno, tone: 'peach', num: '01' },
  { ...terms.gdpr, tone: 'sky', num: '02' },
  { ...terms.liability, tone: 'violet', num: '03' },
];
---

<section class="section" id="podminky" aria-labelledby="podminky-title">
  <div class="container">
    <SectionHeader id="podminky-title" badge="Podmínky" title="Storno podmínky a souhlasy" lead={terms.agreement} />

    <div class="terms">
      {
        blocks.map((block, i) => (
          <article class={`terms__block card terms__block--${block.tone}`} data-reveal style={`--reveal-delay: ${i * 0.08}s`}>
            <p class="terms__num">{block.num}</p>
            <h3 class="terms__title">{block.title}</h3>
            <ul class="terms__list">
              {block.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .terms {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .terms__block--peach {
    --tone: 244, 186, 112;
  }

  .terms__block--sky {
    --tone: 110, 178, 236;
  }

  .terms__block--violet {
    --tone: 168, 132, 238;
  }

  /* Barevná linka nahoře a jemná záře v rohu karty */
  .terms__block {
    overflow: hidden;
    isolation: isolate;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-color: rgba(var(--tone), 0.22);
  }

  .terms__block::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, rgb(var(--tone)), rgba(var(--tone), 0));
  }

  .terms__block::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(110% 70% at 0% 0%, rgba(var(--tone), 0.13), transparent 60%);
    pointer-events: none;
  }

  .terms__block:hover {
    border-color: rgba(var(--tone), 0.45);
  }

  .terms__num {
    margin-bottom: 1.25rem;
    color: rgb(var(--tone));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }

  .terms__title {
    font-size: 1.15rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .terms__list {
    display: grid;
    gap: 0.85rem;
    list-style: none;
  }

  .terms__list li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .terms__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgb(var(--tone));
    box-shadow: 0 0 8px rgba(var(--tone), 0.6);
  }

  @media (max-width: 960px) {
    .terms {
      grid-template-columns: 1fr;
    }
  }
</style>
