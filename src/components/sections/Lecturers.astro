---
import { Picture } from 'astro:assets';
import SectionHeader from '../SectionHeader.astro';
import Corners from '../Corners.astro';
import { lecturers } from '../../data/content.js';
---

<section class="section" id="lektori" aria-labelledby="lektori-title">
  <div class="container">
    <SectionHeader id="lektori-title" badge="Kdo jsme" title={lecturers.title} lead={lecturers.lead} />

    <ul class="people">
      {
        lecturers.people.map((person, i) => (
          <li class="person" data-reveal style={`--reveal-delay: ${i * 0.1}s`}>
            <figure class="person__photo">
              <Corners />
              <Picture
                src={person.photo}
                alt={`Portrét: ${person.name}`}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                widths={[320, 480, 640, 800]}
                sizes="(max-width: 600px) calc(100vw - 3.5rem), (max-width: 1024px) 44vw, 360px"
                class="person__img"
              />
            </figure>
            <div class="person__body">
              <h3 class="person__name">{person.name}</h3>
              <p class="person__role">{person.role}</p>
              <p class="person__bio">{person.bio}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .people {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    list-style: none;
  }

  /* Fotka v rámečku z linek se čtverečky v rozích */
  .person__photo {
    position: relative;
    margin: 0;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .person__photo :global(.person__img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 15%;
    transition: filter 0.4s var(--ease);
  }

  .person:hover :global(.person__img) {
    filter: brightness(1.05);
  }

  .person__body {
    display: grid;
    gap: 0.4rem;
    padding: 1.25rem 0.25rem 0;
  }

  .person__role {
    color: var(--text-subtle);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .person__name {
    font-size: 1.15rem;
    font-weight: 500;
  }

  .person__bio {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 1024px) {
    .people {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .people {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
