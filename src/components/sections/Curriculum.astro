---
import SectionHeader from '../SectionHeader.astro';
import TopicIcon from '../TopicIcon.astro';
import { curriculum, audience } from '../../data/content.js';
---

<section class="section" id="obsah-kurzu" aria-labelledby="obsah-kurzu-title">
  <div class="container">
    <SectionHeader id="obsah-kurzu-title" badge="Obsah kurzu" title={curriculum.title} lead={curriculum.lead} />

    <!-- Řada buněk oddělených linkami, se čtverečky v průsečících (jako v předloze Monitor) -->
    <div class="grid-block" data-reveal>
      <ul class="topics">
        {
          curriculum.items.map((item) => (
            <li class={`topic topic--${item.tone}`}>
              <span class="node node--tl" aria-hidden="true" />
              <span class="node node--br" aria-hidden="true" />
              <TopicIcon name={item.icon as any} />
              <div class="topic__body">
                <h3 class="topic__title">{item.title}</h3>
                <p class="topic__text">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <aside class="audience" aria-labelledby="pro-koho-title">
        <span class="node node--bl" aria-hidden="true" />
        <span class="node node--br" aria-hidden="true" />
        <div>
          <h3 class="audience__title" id="pro-koho-title">{audience.title}</h3>
          <p class="audience__text">{audience.text}</p>
        </div>
        <ul class="audience__places" aria-label="Odkud k nám studenti jezdí">
          {audience.places.map((place) => <li>{place}</li>)}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .grid-block {
    position: relative;
  }

  /* Buňky sdílí linky: mřížka má horní a levou linku, každá buňka pravou a spodní */
  .topics {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    list-style: none;
  }

  .topic {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3.5rem;
    min-height: 260px;
    padding: 1.75rem 1.5rem 1.9rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    isolation: isolate;
    transition: background-color 0.3s var(--ease);
  }

  /* Barevné odstíny z gradientu v úvodu – ikona, záře v rohu a linka nahoře */
  .topic--pink {
    --tone: 240, 127, 180;
    --tone-a: #f7b3d2;
    --tone-b: #e2609e;
  }

  .topic--sky {
    --tone: 110, 178, 236;
    --tone-a: #a9d6f8;
    --tone-b: #4f8fe0;
  }

  .topic--violet {
    --tone: 168, 132, 238;
    --tone-a: #cdb8fb;
    --tone-b: #8a5fe0;
  }

  .topic--peach {
    --tone: 244, 186, 112;
    --tone-a: #fcd9a6;
    --tone-b: #ef9a5c;
  }

  /* Jemná barevná záře z levého horního rohu buňky */
  .topic::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(120% 80% at 0% 0%, rgba(var(--tone), 0.14), transparent 60%);
    opacity: 0.8;
    transition: opacity 0.4s var(--ease);
  }

  /* Barevná linka po horní hraně buňky */
  .topic::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 55%;
    height: 1px;
    background: linear-gradient(90deg, rgba(var(--tone), 0.9), transparent);
    pointer-events: none;
  }

  .topic:hover::before {
    opacity: 1;
  }

  .topic:hover {
    background: rgba(var(--tone), 0.03);
  }

  .topic :global(.topic-icon) {
    width: 40px;
    height: 40px;
    filter: drop-shadow(0 0 14px rgba(var(--tone), 0.35));
    transition: transform 0.5s var(--ease);
  }

  .topic:hover :global(.topic-icon) {
    transform: translateY(-3px);
    transition-delay: 0s;
  }

  .topic__body {
    display: grid;
    gap: 0.55rem;
  }

  .topic__title {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .topic__text {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* Čtverečky v průsečících linek */
  .node {
    position: absolute;
    z-index: 1;
    width: 7px;
    height: 7px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    pointer-events: none;
  }

  .node--tl {
    top: -4px;
    left: -4px;
  }

  .node--br {
    right: -4px;
    bottom: -4px;
  }

  .node--bl {
    left: -4px;
    bottom: -4px;
  }

  /* Zbývající dva rohy mřížky */
  .topics::before,
  .topics::after {
    content: '';
    position: absolute;
    z-index: 1;
    width: 7px;
    height: 7px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
  }

  .topics::before {
    top: -4px;
    right: -4px;
  }

  .topics::after {
    bottom: -4px;
    left: -4px;
  }

  /* Pro koho je kurz – navazující řádek pod buňkami */
  .audience {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.5rem, 3.5vw, 2.25rem) 1.5rem;
    border: 1px solid var(--line);
    border-top: 0;
  }

  .audience__title {
    margin-bottom: 0.6rem;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .audience__text {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .audience__places {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    list-style: none;
  }

  .audience__places li {
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
  }

  @media (max-width: 1024px) {
    .topics {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .audience {
      grid-template-columns: 1fr;
    }

    .audience__places {
      justify-content: flex-start;
    }
  }

  @media (max-width: 520px) {
    .topics {
      grid-template-columns: 1fr;
    }

    .topic {
      min-height: 0;
      gap: 1.75rem;
    }
  }
</style>
