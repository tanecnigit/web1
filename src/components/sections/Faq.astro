---
import Accordion from '../Accordion.astro';
import { faq } from '../../data/content.js';
---

<section class="section faq-section" id="otazky" aria-labelledby="otazky-title">
  <div class="container faq">
    <header class="faq__head" data-reveal>
      <p class="badge">Časté dotazy</p>
      <h2 class="section-title" id="otazky-title">{faq.title}</h2>
      <p class="muted">
        Nenašli jste odpověď? <a href="#kontakt">Ozvěte se nám.</a>
      </p>
    </header>

    <!-- Seznam otázek vede od horní k dolní lince sekce a až ke konstrukční lince vpravo (jako v předloze) -->
    <div class="faq__list" data-reveal style="--reveal-delay: 0.1s">
      {
        faq.items.map((item, i) => (
          <Accordion title={item.q} group="faq" open={i === 0}>
            <p>{item.a}</p>
          </Accordion>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding-block: 0;
  }

  .faq {
    display: grid;
    grid-template-columns: 1fr 1.9fr;
    align-items: stretch;
  }

  .faq__head {
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding-block: var(--section-y);
    padding-right: 2rem;
  }

  .faq__head a {
    color: var(--text);
    text-underline-offset: 3px;
  }

  .faq__list {
    margin-right: calc(-1 * var(--frame-pad));
    border-left: 1px solid var(--line);
  }

  /* Poslední řádek navazuje přímo na linku další sekce */
  .faq__list :global(.accordion:last-child) {
    border-bottom: 0;
  }

  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
    }

    .faq__head {
      position: static;
      padding-block: var(--section-y) 2.5rem;
    }

    .faq__list {
      margin-left: calc(-1 * var(--frame-pad));
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
