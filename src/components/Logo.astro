---
import { Image } from 'astro:assets';
import silhouette from '../assets/brand/logo-silhouette.png';
import { site } from '../data/content.js';

interface Props {
  href?: string;
  /** Zobrazit siluetu tanečního páru vedle textu */
  mark?: boolean;
}

const { href = '#top', mark = false } = Astro.props;
---

<a class="logo" href={href} aria-label={`${site.name} – úvod`}>
  {mark && <Image src={silhouette} alt="" width={48} height={53} densities={[1, 2]} class="logo__mark" loading="eager" />}
  <span class="logo__name">Taneční Škola <span>Nový Jičín</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text);
    text-decoration: none;
  }

  .logo__mark {
    width: 22px;
    height: auto;
    transition: transform 0.4s var(--ease);
  }

  .logo:hover .logo__mark {
    transform: rotate(-6deg) scale(1.08);
  }

  .logo__name {
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .logo__name span {
    color: rgba(255, 255, 255, 0.6);
  }
</style>
